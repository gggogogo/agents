# ================================
# 火山引擎 Embedding 配置
# ================================
# API密钥 - 从火山引擎控制台获取：https://console.volcengine.com/ark
EMBED_API_KEY=your_api_key_here

# 模型名称 - 推理接入点ID（如：ep-20251210092223-86kdd）
EMBED_MODEL_NAME=your_endpoint_id_here

# API 基础URL
EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 向量维度（根据模型而定，需要从火山引擎文档查询）
# 常见维度：512, 768, 1024, 1536
EMBED_DIMENSION=1024

# ================================
# Qdrant 向量数据库配置
# ================================
# Qdrant 云服务URL
QDRANT_URL=https://your-cluster.gcp.cloud.qdrant.io

# Qdrant API密钥
QDRANT_API_KEY=your_qdrant_api_key

# Qdrant 集合名称
QDRANT_COLLECTION=sdk_docs

# ================================
# API 服务配置（可选）
# ================================
API_HOST=0.0.0.0
API_PORT=3001
API_WORKERS=4
LOG_LEVEL=INFO

# API 认证Token（可选）
API_TOKEN=
